PORT=5000
# Generate with: npm run secrets:generate
# Required secret: JWT_SECRET
JWT_EXPIRES_IN=1h
AUTH_COOKIE_NAME=__Host-myajo_session
AUTH_COOKIE_MAX_AGE_SECONDS=3600
AUTH_COOKIE_SECURE=true
# MFA secrets remain encrypted. During deployment, reuse the application's
# current 64-character hexadecimal field key here so existing MFA still works.
# Required secret: MFA_ENCRYPTION_KEY
MFA_ENCRYPTION_KEY_VERSION=1
# Required secret: OTP_PEPPER
PASSWORD_ROUNDS=12
ALLOWED_ORIGINS=https://my-ajo.org,https://www.my-ajo.org,https://localhost,capacitor://localhost

DB_SERVER=database.example.internal
DB_PORT=1433
DB_NAME=MyAjoDB
DB_USER=myajo_app
# Required secret: DB_PASSWORD
DB_ENCRYPT=true
DB_TRUST_CERT=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
# Required secret: SMTP_PASS

APP_BASE_URL=https://www.my-ajo.org

# Required for conversational My Ajo AI. Without it, the app uses basic guide mode.
# Optional secret: OPENAI_API_KEY
OPENAI_SUMMARY_MODEL=gpt-5-mini

GOOGLE_CLIENT_ID=your-google-client-id
# Optional secret: GOOGLE_CLIENT_SECRET

MICROSOFT_CLIENT_ID=your-microsoft-client-id
# Optional secret: MICROSOFT_CLIENT_SECRET

VAPID_SUBJECT=mailto:push-contact@example.com
VAPID_PUBLIC_KEY=your-vapid-public-key
# Optional secret: VAPID_PRIVATE_KEY
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-example@your-firebase-project-id.iam.gserviceaccount.com
# Preserve escaped newlines when setting multiline private keys in a .env file.
# Optional secret: FCM_PRIVATE_KEY
APNS_KEY_ID=your-apple-push-key-id
APNS_TEAM_ID=your-apple-developer-team-id
# Optional secret: APNS_PRIVATE_KEY
APNS_BUNDLE_ID=com.myajo.app
APNS_PRODUCTION=false
